<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1">

    <title><%= pageTitle %> | LIBIS</title>

    <!-- Bootstrap 5.3.8 -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
        crossorigin="anonymous">

    <!-- LIBIS Custom CSS -->
    <link
        rel="stylesheet"
        href="${pageContext.request.contextPath}/css/libis.css">

</head>

<body>

<nav class="navbar navbar-expand-lg libis-navbar">

    <div class="container">

        <a class="navbar-brand"
           href="${pageContext.request.contextPath}/index.jsp">

            📚 LIBIS

        </a>


        <!-- Mobile menu button -->

        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#libisNavbar">

            <span class="navbar-toggler-icon"></span>

        </button>


        <div class="collapse navbar-collapse"
             id="libisNavbar">

            <ul class="navbar-nav ms-auto">

                <li class="nav-item">

                    <a class="nav-link"
                       href="${pageContext.request.contextPath}/index.jsp">

                        Home

                    </a>

                </li>

                <li class="nav-item">

                    <a class="nav-link"
                       href="${pageContext.request.contextPath}/signup.jsp">

                        Join Library

                    </a>

                </li>

                <li class="nav-item">

                    <a class="nav-link"
                       href="${pageContext.request.contextPath}/member-search.jsp">

                        Member Directory

                    </a>

                </li>

            </ul>

        </div>

    </div>

</nav>

<main class="libis-main">